# Домен, который попадёт в QR-коды. Менять после печати открыток нельзя.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Обязательные секреты
ADMIN_PASSWORD=
# Минимум 32 символа
SESSION_SECRET=

# Папка для базы, фото и песен
DATA_DIR=./data

# 1, если приложение стоит за nginx или другим обратным прокси
TRUST_PROXY=0
